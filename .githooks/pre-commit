#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --no-banner "$@"
    return
  fi

  if command -v docker >/dev/null 2>&1; then
    docker run --rm \
      -v "$repo_root:/repo" \
      -w /repo \
      zricethezav/gitleaks:latest \
      protect --staged --redact --no-banner "$@"
    return
  fi

  echo "gitleaks pre-commit hook failed: install gitleaks or Docker." >&2
  exit 127
}

run_gitleaks

staged_powershell_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.ps1' '*.psm1' '*.psd1')"

if [ -n "$staged_powershell_files" ]; then
  set -- -NoProfile -File ./scripts/Format-OwnerLensLight.ps1 -Check
  while IFS= read -r path; do
    set -- "$@" "$path"
  done <<EOF
$staged_powershell_files
EOF
  pwsh "$@"
fi
